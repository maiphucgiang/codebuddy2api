# Copy to .env for first use; preserve existing settings when updating.
# 首次使用复制为 .env；升级时保留已有配置。
# Compose loads every key in this file into the container, so unrelated keys are harmless;
# native launches read it too, and native zero-configuration startup can omit it.
# Compose 会把本文件的每个键加载进容器，无关的键不会造成影响；原生启动同样读取它，
# 零配置的原生启动可以省略该文件。
# Runtime keys here stay read-only in the WebUI. To let the WebUI own them, stop the
# service and run `python3 converter.py config migrate` (add --data-dir/--env-file when
# the paths differ), then delete the printed lines. Deployment keys below are never migrated.
# 这里列出的运行参数在 WebUI 中只读。要让 WebUI 接管，请停止服务后运行
# `python3 converter.py config migrate`（路径不同时加 --data-dir/--env-file），
# 再删除它打印的行；下方的部署类键不会被迁移。

# Native listener and Compose host mapping; explicit --host/--port override native values.
# 原生监听地址与 Compose 宿主机映射；显式 --host/--port 覆盖原生取值。
CODEBUDDY2API_BIND=127.0.0.1
CODEBUDDY2API_PORT=8787

# Compose image; uncomment to override, leaving it commented keeps the published latest tag.
# Compose 镜像；取消注释才会覆盖，保持注释即使用已发布的 latest 标签。
# CODEBUDDY2API_IMAGE=ghcr.io/maiphucgiang/codebuddy2api:latest
# Compose host data directory; container data stays in /data/auth.
# Compose 宿主机数据目录；容器内数据固定在 /data/auth。
CODEBUDDY2API_AUTH_PATH=./auth
# Container time zone; daily guards follow it, and an unset value keeps UTC.
# 容器时区；每日任务按它跨天，未设置时保持 UTC。
# TZ=Asia/Shanghai
# Optional Compose override for the env file path, used instead of .env.
# 可选的 Compose 覆盖项：改读其他 env 文件而非 .env。
# CODEBUDDY2API_ENV_FILE=.env

# Optional native data directory; Compose fixes CODEBUDDY_AUTH_DIR to /data/auth.
# 可选的原生数据目录；Compose 会把 CODEBUDDY_AUTH_DIR 固定为 /data/auth。
# CODEBUDDY_AUTH_DIR=./auth
# Import directory defaults to the data directory's imports/; use container paths in Compose.
# 导入目录默认是数据目录下的 imports/；Compose 中请使用容器内路径。
# CODEBUDDY_IMPORT_DIR=./auth/imports

# Empty locks management; set a random key before exposing inference beyond loopback.
# 留空即锁定管理；对外暴露推理端口前请设置随机密钥。
# Native: omit/comment the variable to use the saved default key (first local start displays it once).
# 原生：省略或注释该变量会使用已保存的默认 key（首次本地启动会显示一次）。
CODEBUDDY2API_KEY=
# Opt-in for headless/non-loopback no-auth runs; the image and Compose already force it on.
# 原生后台或非回环免鉴权运行选项；镜像与 Compose 已固定开启。
# CODEBUDDY2API_ALLOW_OPEN_NOAUTH=false

# Disabling CSRF checks does not disable authentication; use only on trusted local networks.
# 关闭 CSRF 校验不等于关闭认证；仅在可信本地网络使用。
CODEBUDDY2API_ADMIN_CSRF=true

# Extra trusted management origins behind reverse proxies (comma separated; bare domains use HTTPS).
# 反代后额外信任的管理来源（逗号分隔；裸域名按 HTTPS 处理）。
# Unset leaves the list configurable in the WebUI; an explicit value locks it.
# 不设置时列表可在 WebUI 修改；显式设置会锁定。
# CODEBUDDY2API_ADMIN_ORIGINS=https://chat.example.com
# Trusted proxy IPs/CIDRs; a matching peer makes the audit log record X-Forwarded-For/X-Real-IP.
# 可信代理 IP/CIDR；命中时审计改记 X-Forwarded-For/X-Real-IP 中的真实客户端地址。
# CODEBUDDY2API_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# GitHub download mirror prefix for one-click updates; empty downloads directly. Release
# lists still come from api.github.com, whose digest must match what the mirror serves.
# 一键更新的 GitHub 下载镜像前缀；留空直连。版本列表仍直连 api.github.com，镜像内容须与其摘要一致。
# Unset leaves the mirror selectable in the WebUI; an explicit value locks it.
# 不设置时可在 WebUI 选择并测速；显式设置会锁定。
# CODEBUDDY2API_UPDATE_MIRROR=https://ghfast.top/

# Scheduled backups of control.sqlite3 into backups/ (never credentials); only scheduled ones are
# pruned down to the limit. Unset leaves them configurable under Storage; explicit values lock them.
# 定时把 control.sqlite3 备份到 backups/（不含凭证），只清理超出上限的自动备份。
# 不设置时可在「存储管理」修改；显式设置会锁定。
# CODEBUDDY2API_BACKUP_AUTO=true
# CODEBUDDY2API_BACKUP_INTERVAL_HOURS=24
# CODEBUDDY2API_BACKUP_KEEP=7

# Local media storage for generated images and videos. The base URL prefixes public asset
# links; when empty images return b64 only and saved videos expose no link.
# 生成图片与视频的本地存储。资源访问地址用于拼接公开资源链接；留空时图片只返回
# b64，已保存的视频不回传链接。不设置时可在「媒体生成」页修改；显式设置会锁定。
# CODEBUDDY2API_MEDIA_BASE_URL=https://media.example.com
# CODEBUDDY2API_MEDIA_MAX_TOTAL_MB=1024
# CODEBUDDY2API_MEDIA_TTL_HOURS=72

# Unset leaves tool metadata configurable in the WebUI; an explicit Boolean locks it.
# 不设置时工具元数据可在 WebUI 修改；显式布尔值会锁定。
# CODEBUDDY2API_KEEP_TOOL_METADATA=true

# Image overflow keeps the newest blocks or returns 413; zero forbids all images.
# 图片超限时保留最新内容或返回 413；设为 0 禁止全部图片。
CODEBUDDY2API_MAX_IMAGES=16
CODEBUDDY2API_IMAGE_POLICY=truncate
# Positive upstream JSON byte limit after image policy and protocol adaptation.
# 图片策略与协议适配之后，发往上游的 JSON 字节上限（正数）。
CODEBUDDY2API_MAX_REQUEST_BYTES=33554432
# Positive raw inbound byte limit, enforced before JSON parsing.
# 原始入站字节上限（正数），在解析 JSON 之前生效。
CODEBUDDY2API_MAX_INBOUND_BYTES=67108864
# Aggregated output bytes and concurrent inference requests; zero disables each limit.
# 聚合输出字节数与并发推理请求数；设为 0 分别关闭对应限制。
CODEBUDDY2API_MAX_COLLECT_BYTES=8388608
CODEBUDDY2API_MAX_CONCURRENT=64
# Optional bounded upstream connection reuse; restart to apply, disabled by default.
# 可选的上游连接复用（有上限）；修改后需重启，默认关闭。
# CODEBUDDY2API_UPSTREAM_KEEPALIVE=false
# Per-account in-flight limit; zero keeps account capacity unlimited.
# 单账号在途请求上限；设为 0 保持账号容量不受限。
# CODEBUDDY2API_MAX_INFLIGHT_PER_ACCOUNT=0
# Optional system prompt prefix; empty adds no gateway default, prepend uses the routed profile prompt.
# 可选系统提示词前缀；empty 不附加网关默认提示词，prepend 按后端插入精简官方提示词。
# CODEBUDDY2API_PROMPT_MODE=empty
# Optional session/attempt tracing; legacy keeps existing upstream header behavior.
# 可选的会话/尝试追踪；legacy 保持现有上游请求头行为。
# CODEBUDDY2API_REQUEST_CONTEXT_MODE=legacy
# Responses projection is hot and WebUI-editable unless explicitly set here.
# Responses 投影可热生效且默认可在 WebUI 修改，除非在此显式设置。
# balanced only rewrites recognized harness blocks with stable summaries; other text stays verbatim.
# balanced 只改写可识别的 harness 块并生成稳定摘要，其余文本保持原样。
# CODEBUDDY2API_RESPONSES_PROJECTION_MODE=balanced
# Per-item head/tail limit for generated assistant text, tool arguments and tool results;
# zero disables per-item trimming. Global request/output gates still apply.
# 生成文本、工具参数与工具结果的单项首尾截断上限；设为 0 关闭单项截断，
# 全局请求与输出限制仍然生效。
# Non-zero values must be between 256 and 33554432 bytes.
# 非零取值须在 256 至 33554432 字节之间。
# CODEBUDDY2API_RESPONSES_PROJECTION_MAX_BYTES=40000
# compatible keeps aggregation; realtime forwards all protocol output incrementally
# and does not regenerate malformed tool arguments.
# compatible 保持聚合；realtime 增量转发全部协议输出，且不重新生成损坏的工具参数。
# CODEBUDDY2API_STREAM_MODE=compatible
# Disable only the declared model-capability preflight; other safeguards and Intl image merging remain.
# 只关闭声明的模型能力预检；其他保护与国际站图片合并仍然生效。
# CODEBUDDY2API_MODEL_CAPABILITY_GUARD=true
# Routing scheduler: indexed reuses per-model shards, shadow records legacy/indexed differences
# while returning the legacy answer, legacy rescans every credential on each request.
# 路由调度：indexed 复用按模型分片（默认），shadow 记录新旧差异但仍返回旧结果，legacy 每次全量判断。
# CODEBUDDY2API_ROUTING_SCHEDULER=indexed
# Catalog probing: representative probes one account per product per TTL cycle; account refreshes all.
# 目录探测：representative 每个产品每周期只探测一个代表账号（默认），account 逐个账号刷新。
# CODEBUDDY2API_CATALOG_PROBE_MODE=representative
# Bounded background maintenance workers; 1 restores the previous serial behaviour.
# 后台维护并发数；设为 1 即退化为串行。
# CODEBUDDY2API_HOUSEKEEP_CONCURRENCY=4

# Retired: this setting only warns; all persistent logs use logs.sqlite3.
# 已停用：该项只会给出告警；所有持久日志都写入 logs.sqlite3。
CODEBUDDY2API_LOG=
# Legacy text-preview limit; text output is retired. SQLite diagnostics have a separate budget.
# 旧版文本预览上限；文本输出已停用，SQLite 诊断另有独立预算。
CODEBUDDY2API_LOG_BODY_LIMIT=65536

# International trial credits remain manual-only in the WebUI.
# 国际站试用积分仍需在 WebUI 手动领取。
# Preauthorize first-Buddy tasks: one bounded chat (may use credits), adoption and travel.
# 预授权首次 Buddy 任务：一次有上限的对话（可能消耗积分）、领养与旅行。
CODEBUDDY2API_AUTO_ACCEPT_BUDDY=false

# Extra generations for malformed tool arguments; each may consume credits, zero disables retries.
# 损坏工具参数的额外生成次数；每次可能消耗积分，设为 0 关闭重试。
CODEBUDDY2API_TOOL_CALL_MAX_RETRY=3
# Pre-response credential failovers; zero disables replay. See docs/advanced.md for billing risks.
# 响应前的凭证故障切换次数；设为 0 关闭重放。计费风险见 docs/advanced.md。
CODEBUDDY2API_FAILOVER_MAX=0
# Replay incomplete writes only when partial requests cannot be billed upstream.
# 仅在部分写入不会被上游计费时才重放未完成的请求。
CODEBUDDY2API_RETRY_WRITE_TIMEOUT=false
